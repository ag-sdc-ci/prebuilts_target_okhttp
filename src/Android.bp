// Extractive JVM/Maven apex: jars staged under share/ dirs
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_import {
    name: "okhttp",
    jars: ["share/okhttp/okhttp-2.7.5.jar"],
    host_supported: true,
    min_sdk_version: "28",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

java_import {
    name: "okhttp-norepackage",
    jars: ["share/okhttp-norepackage/okhttp-2.7.5.jar"],
    host_supported: true,
    min_sdk_version: "28",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

java_import {
    name: "okhttp-urlconnection",
    jars: ["share/okhttp-urlconnection/okhttp-urlconnection-2.7.5.jar"],
    host_supported: true,
    min_sdk_version: "28",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

java_import {
    name: "okhttp-ws",
    jars: ["share/okhttp-ws/okhttp-ws-2.7.5.jar"],
    host_supported: true,
    min_sdk_version: "28",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}
